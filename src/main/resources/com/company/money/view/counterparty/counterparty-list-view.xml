<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://counterpartyListView.title"
      focusComponent="counterpartiesDataGrid">
    <data>
        <collection id="counterpartiesDc" class="com.company.money.entity.Counterparty">
            <fetchPlan extends="_base"/>
            <loader id="counterpartiesDl" readOnly="true">
                <query>
                    <![CDATA[select e from vshd1_Counterparty e where e.deletionMark = false order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter" dataLoader="counterpartiesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel" width="100%" wrap="true">
            <startSlot>
                <button id="createButton" action="counterpartiesDataGrid.createAction"/>
                <button id="editButton" action="counterpartiesDataGrid.editAction"/>
                <button id="removeButton" action="counterpartiesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="counterpartiesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="counterpartiesDataGrid" dataContainer="counterpartiesDc" width="100%"
                  minHeight="20em" columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="name" autoWidth="true"/>
                <column property="inn" width="9rem"/>
                <column property="kpp" width="9rem"/>
                <column property="code" width="8rem"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
