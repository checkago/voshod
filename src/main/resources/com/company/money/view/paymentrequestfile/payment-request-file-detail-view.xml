<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://paymentRequestFileDetailView.title"
      focusComponent="form">
    <data>
        <instance id="paymentRequestFileDc" class="com.company.money.entity.PaymentRequestFile">
            <fetchPlan extends="_base"/>
            <loader id="paymentRequestFileDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="paymentRequestFileDc">
            <fileStorageUploadField id="contentFileField" property="contentFile"/>
            <textField id="descriptionField" property="description"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
